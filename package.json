{
  "name": "claude-code-router",
  "version": "3.1.1",
  "private": true,
  "description": "Claude Code Router: local LLM router for LM Studio, Ollama and llama.cpp with a real account system",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node test/run.js",
    "setup:app": "node scripts/install.js",
    "test:install": "node --test test/install.test.js",
    "test:launch": "node --test test/launcher.test.js"
  },
  "engines": {
    "node": ">=20"
  }
}
